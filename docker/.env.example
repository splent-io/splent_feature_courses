# Everything a particular subject decides about its wiki. The defaults are
# neutral on purpose: this feature does not know which subject it serves.

# Timezone release dates are typed in. Moments are stored in UTC, but a lab
# at 08:00 means 08:00 where the course is taught.
COURSES_TIMEZONE=Europe/Madrid

# The words the URLs use. They end up in slides and e-mails and are read
# for years, so a wiki replacing an older one sets these to whatever that
# one served instead of breaking every link already written down.
COURSES_PATH=cursos
COURSES_CATEGORY_SEGMENT=categoria
COURSES_PAGE_SEGMENT=pagina

# How a new academic year is named and described. A prefix containing
# braces is used as a full template, otherwise it goes in front of the
# year. The description accepts {year}, {start}, {end} and {short}.
COURSES_NAME_PREFIX=
COURSES_DESCRIPTION_TEMPLATE=

# The categories a new course starts with, comma separated. Empty means an
# empty course.
COURSES_DEFAULT_CATEGORIES=
