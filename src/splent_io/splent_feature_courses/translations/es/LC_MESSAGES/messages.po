#: src/splent_io/splent_feature_courses/templates/courses/admin/course_form.html:114
msgid "Remove this page?"
msgstr "¿Eliminar esta página?"

#: src/splent_io/splent_feature_courses/templates/courses/admin/course_form.html:85
msgid "No pages in this section yet."
msgstr "Esta categoría todavía no tiene páginas."

#: src/splent_io/splent_feature_courses/templates/courses/admin/course_form.html:92
msgid "This course has no sections yet."
msgstr "Este curso todavía no tiene categorías."

#: src/splent_io/splent_feature_courses/templates/courses/admin/course_form.html:98
msgid "Outside any section"
msgstr "Fuera de toda categoría"

#: src/splent_io/splent_feature_courses/templates/courses/admin/course_form.html:99
msgid ""
"These pages are reachable but are listed on their own. Give them a "
"section to file them."
msgstr ""
"Estas páginas son accesibles pero aparecen sueltas. Asígnales una "
"categoría para colocarlas."

#: src/splent_io/splent_feature_courses/templates/courses/admin/courses.html:10
msgid ""
"One course per academic year. Each one is a snapshot: editing this year "
"never changes what an earlier one shows."
msgstr ""
"Un curso por año académico. Cada uno es una instantánea: editar el de "
"este año nunca cambia lo que muestra uno anterior."

#: src/splent_io/splent_feature_courses/templates/courses/admin/courses.html:23
msgid "Readers see it"
msgstr "Los lectores lo ven"

