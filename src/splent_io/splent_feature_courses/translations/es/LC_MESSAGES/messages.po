#: src/splent_io/splent_feature_courses/templates/courses/admin/category_form.html:22
msgid "Sections are ordered by hand, lowest first."
msgstr "Las categorías se ordenan a mano, de menor a mayor."

#: src/splent_io/splent_feature_courses/templates/courses/admin/category_form.html:24
msgid ""
"Withholding a section withholds every page in it, whatever those pages "
"say on their own."
msgstr ""
"Retener una categoría retiene todas sus páginas, digan lo que digan ellas"
" por su cuenta."

#: src/splent_io/splent_feature_courses/templates/courses/admin/category_form.html:27
#: src/splent_io/splent_feature_courses/templates/courses/admin/course_form.html:35
